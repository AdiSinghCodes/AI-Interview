# Copy to .env. Every value here is INFRASTRUCTURE, not model choice —
# model names live only in config/models.yaml.

# Ollama daemon (local LLMs: interviewer, planner, embedder, + Groq fallbacks)
ENGINE_OLLAMA_HOST=http://localhost:11434

# Optional. Enables the Groq-first path for the parser and scorer roles.
# Leave unset and those roles use their local qwen3:8b fallback automatically.
ENGINE_GROQ_API_KEY=

# Postgres + pgvector. Used from build-order pass 7 (retrieval) onward.
ENGINE_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5433/interview

# Where generated audio / report artifacts get written (later passes).
ENGINE_MEDIA_ROOT=./media
