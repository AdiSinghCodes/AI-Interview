# Normalize line endings across every clone, regardless of each dev's
# core.autocrlf setting. Text files are stored LF in the repo; Windows-only
# scripts keep CRLF; binaries are never touched.

# Default: treat as text, store LF in the repo, check out LF everywhere.
* text=auto eol=lf

# --- Source & config (explicit LF) ---
*.py      text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
.env.example text eol=lf

# --- Windows-only scripts: keep CRLF ---
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# --- Binary: never convert, never diff as text ---
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.pdf     binary
*.zip     binary
*.mp4     binary
*.mov     binary
*.avi     binary
*.wav     binary
*.mp3     binary
*.glb     binary
*.gltf    binary
*.pt      binary
*.pth     binary
*.onnx    binary
*.ckpt    binary
*.safetensors binary
*.bin     binary
